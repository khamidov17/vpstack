#!/usr/bin/env bash
# vpstack-learnings-search — search and surface research learnings
#
# Usage:
#   vpstack-learnings-search                    # show all, newest first
#   vpstack-learnings-search --limit 3          # top 3 most recent
#   vpstack-learnings-search --query "B1 alpha" # substring search
#   vpstack-learnings-search --source vp-spike  # filter by source skill

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SLUG=$("${SCRIPT_DIR}/vpstack-slug" 2>/dev/null || basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")
LEARNINGS_FILE="$HOME/.vpstack/projects/$SLUG/learnings.jsonl"

LIMIT=10
QUERY=""
SOURCE_FILTER=""

while [ $# -gt 0 ]; do
  case "$1" in
    --limit)  LIMIT="$2"; shift 2 ;;
    --query)  QUERY="$2"; shift 2 ;;
    --source) SOURCE_FILTER="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) shift ;;
  esac
done

if [ ! -f "$LEARNINGS_FILE" ]; then
  echo "No learnings yet for project $SLUG"
  echo "Use vpstack-learnings-log to record research insights."
  exit 0
fi

python3 - << PYEOF
import json, sys

with open("$LEARNINGS_FILE") as f:
    lines = f.read().strip().splitlines()

entries = []
for line in lines:
    try:
        entries.append(json.loads(line))
    except json.JSONDecodeError:
        continue

# Newest first
entries.reverse()

# Filter
query = "$QUERY".lower()
source_filter = "$SOURCE_FILTER".lower()

if query:
    entries = [e for e in entries
               if query in e.get("key","").lower()
               or query in e.get("insight","").lower()
               or query in " ".join(e.get("tags", [])).lower()]

if source_filter:
    entries = [e for e in entries if e.get("source","").lower() == source_filter]

# Limit
entries = entries[:int("$LIMIT")]

if not entries:
    print("No learnings match your query.")
    sys.exit(0)

print(f"Research learnings ({len(entries)} found):")
print()
for e in entries:
    conf = e.get("confidence", "?")
    src  = e.get("source", "manual")
    ts   = e.get("ts", "")[:10]
    key  = e.get("key", "")
    insight = e.get("insight", "")
    print(f"[{key}] (confidence: {conf}, source: {src}, {ts})")
    print(f"  {insight}")
    print()
PYEOF
