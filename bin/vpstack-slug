#!/usr/bin/env bash
# vpstack-slug — emit the project slug for ~/.vpstack/projects/{slug}/.
#
# Format: {repo-basename}-{sha256[:8] of "user:absolute-toplevel-path"}
#
# Includes $USER in the hash so two researchers on a shared machine with the
# same repo name (e.g. both have ~/vp2026/) write to separate directories.
# Without $USER, one researcher's experiments silently overwrite the other's.
#
# Skills call this instead of rolling their own basename logic:
#   SLUG=$(~/.claude/skills/vpstack/bin/vpstack-slug 2>/dev/null \
#       || .claude/skills/vpstack/bin/vpstack-slug 2>/dev/null \
#       || basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")

set -euo pipefail

TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
NAME=$(basename "$TOPLEVEL")
[ -z "$NAME" ] && NAME="unknown"

# Include USER in the hash seed — prevents slug collision on shared machines.
# Use whoami as fallback if $USER is unset (some cluster environments).
WHOAMI="${USER:-$(whoami 2>/dev/null || echo nobody)}"
HASH_SEED="${WHOAMI}:${TOPLEVEL}"

if command -v sha256sum >/dev/null 2>&1; then
  HASH=$(printf '%s' "$HASH_SEED" | sha256sum | cut -c1-8)
elif command -v shasum >/dev/null 2>&1; then
  HASH=$(printf '%s' "$HASH_SEED" | shasum -a 256 | cut -c1-8)
else
  HASH=$(python3 -c "import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest()[:8])" "$HASH_SEED")
fi

printf '%s-%s\n' "$NAME" "$HASH"
