#!/usr/bin/env bash
# vpstack-utmos — UTMOS perceptual MOS scoring for VP2026 naturalness eval.
#
# Predicts mean opinion score (PMOS) for each WAV in a directory using a
# pretrained UTMOS model. UTMOS22 from sarulab-speech / SpeechMOS package.
#
# Usage:
#   vpstack-utmos --audio_path /path/to/wavs \
#                 [--seed 42] [--output_format json]
#
# Output (JSON on stdout):
#   {ok, method, n_files, pmos_mean, pmos_std, pmos_min, pmos_max,
#    config_hash, seed, per_file}
#
# Direction: higher PMOS = more natural (1=bad, 5=excellent).
#
# Dependencies: pip install speechmos torch torchaudio
# Reference: Saeki et al. "UTMOS: UTokyo-SaruLab System for VoiceMOS Challenge
# 2022" (Interspeech 2022, arXiv:2204.02152).

set -euo pipefail

AUDIO_PATH=""
SEED="42"
OUTPUT_FORMAT="json"

while [ $# -gt 0 ]; do
  case "$1" in
    --audio_path)    AUDIO_PATH="$2";    shift 2 ;;
    --seed)          SEED="$2";          shift 2 ;;
    --output_format) OUTPUT_FORMAT="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "Unknown flag: $1" >&2; exit 1 ;;
  esac
done

[ -z "$AUDIO_PATH" ] && { echo "Error: --audio_path required" >&2; exit 1; }
[ -d "$AUDIO_PATH" ] || { echo "Error: audio_path does not exist: $AUDIO_PATH" >&2; exit 1; }

AUDIO_PATH="$AUDIO_PATH" SEED="$SEED" OUTPUT_FORMAT="$OUTPUT_FORMAT" \
python3 - << 'PYEOF'
import os, sys, json, time, hashlib, statistics
from pathlib import Path

try:
    import torch
    import torchaudio
except ImportError:
    print(json.dumps({"ok": False, "error": {"code": "DEPS_MISSING",
        "hint": "pip install torch torchaudio"}}))
    sys.exit(1)

try:
    from speechmos import utmos22
except ImportError:
    print(json.dumps({"ok": False, "error": {"code": "DEPS_MISSING",
        "hint": "pip install speechmos"}}))
    sys.exit(1)

AUDIO_PATH = Path(os.environ["AUDIO_PATH"]).expanduser()
SEED = int(os.environ["SEED"])
OUTPUT_FORMAT = os.environ["OUTPUT_FORMAT"]

torch.manual_seed(SEED)

wavs = sorted(AUDIO_PATH.rglob("*.wav"))
if not wavs:
    print(json.dumps({"ok": False, "error": {"code": "DATA_MISSING",
        "hint": f"No .wav files under {AUDIO_PATH}"}}))
    sys.exit(1)

print(f"vpstack-utmos: scoring {len(wavs)} files via UTMOS22 ...", file=sys.stderr)

per_file = {}
scores = []
n_done = 0
n_skipped = 0
t0 = time.time()
last_log = t0

for wav in wavs:
    try:
        sig, sr = torchaudio.load(str(wav))
        if sig.shape[0] > 1:
            sig = sig.mean(dim=0, keepdim=True)
        # speechmos.utmos22.predict expects numpy + native sample rate
        wav_np = sig.squeeze(0).cpu().numpy()
        score = utmos22.predict(wav_np, sr)
        score = float(score)
    except Exception as e:
        print(f"vpstack-utmos: skipping {wav.name}: {e}", file=sys.stderr)
        n_skipped += 1
        continue
    per_file[wav.stem] = round(score, 3)
    scores.append(score)
    n_done += 1

    now = time.time()
    if now - last_log > 30 or n_done == len(wavs):
        elapsed = now - t0
        rate = n_done / elapsed if elapsed > 0 else 0
        eta = (len(wavs) - n_done) / rate if rate > 0 else 0
        print(f"vpstack-utmos: {n_done}/{len(wavs)} done, ETA {eta:.0f}s",
              file=sys.stderr, flush=True)
        last_log = now

if not scores:
    print(json.dumps({"ok": False, "error": {"code": "NO_FILES_SCORED",
        "hint": "every WAV failed to score — check that files are valid PCM"}}))
    sys.exit(1)

cfg_str = f"UTMOS22:speechmos:seed={SEED}"
cfg_hash = hashlib.sha256(cfg_str.encode()).hexdigest()[:16]

result = {
    "ok": True,
    "method": "UTMOS22 (speechmos)",
    "n_files": n_done,
    "n_skipped": n_skipped,
    "pmos_mean": round(statistics.mean(scores), 3),
    "pmos_std":  round(statistics.pstdev(scores), 3) if len(scores) > 1 else 0.0,
    "pmos_min":  round(min(scores), 3),
    "pmos_max":  round(max(scores), 3),
    "config_hash": cfg_hash,
    "seed": SEED,
    "per_file": per_file,
}

if OUTPUT_FORMAT == "json":
    print(json.dumps(result))
else:
    print(f"vpstack-utmos: {n_done} files scored, {n_skipped} skipped")
    print(f"PMOS mean: {result['pmos_mean']:.3f}  std: {result['pmos_std']:.3f}")
    print(f"PMOS range: [{result['pmos_min']:.3f}, {result['pmos_max']:.3f}]")
    print(f"Direction: higher = more natural (1=bad, 5=excellent)")
    print(f"config hash: {cfg_hash}")
PYEOF
