#!/usr/bin/env bash
# vpstack-lock — generate or verify a checkpoints.lock file for reproducibility.
#
# checkpoints.lock format (one line per checkpoint):
#   <name>  sha256:<hex>  <source_url_or_hf_id>
#
# Usage:
#   vpstack-lock generate /path/to/model1 /path/to/model2 ...    # writes checkpoints.lock
#   vpstack-lock verify checkpoints.lock                          # exits 0 if all hashes match
#   vpstack-lock add NAME PATH [SOURCE_URL]                       # append entry to existing lock
#
# Generate hashes via shasum (macOS) or sha256sum (Linux).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

cmd_hash() {
  local file="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$file" | awk '{print $1}'
  else
    echo "Error: no sha256sum or shasum found" >&2
    exit 1
  fi
}

cmd_generate() {
  local out_file="checkpoints.lock"
  echo "# checkpoints.lock — generated by vpstack-lock $(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$out_file"
  echo "# format: <name>  sha256:<hex>  <source>" >> "$out_file"
  for path in "$@"; do
    if [ ! -f "$path" ]; then
      echo "Warning: skipping $path (not a file)" >&2
      continue
    fi
    local name
    name=$(basename "$path")
    name="${name%.*}"  # strip extension
    local hash
    hash=$(cmd_hash "$path")
    echo "$name  sha256:$hash  $path" >> "$out_file"
    echo "Locked: $name = sha256:${hash:0:16}..." >&2
  done
  echo "vpstack-lock: wrote $out_file" >&2
}

cmd_verify() {
  local lock_file="${1:-checkpoints.lock}"
  [ -f "$lock_file" ] || { echo "Error: $lock_file not found" >&2; exit 1; }

  local fail=0
  local total=0
  local pass=0

  while IFS= read -r line; do
    case "$line" in
      ''|\#*) continue ;;
    esac
    local name expected source path
    name=$(echo "$line" | awk '{print $1}')
    expected=$(echo "$line" | awk '{print $2}' | sed 's/^sha256://')
    source=$(echo "$line" | awk '{print $3}')
    path="$source"
    total=$((total + 1))

    if [ ! -f "$path" ]; then
      echo "MISSING: $name (expected at $path)"
      fail=$((fail + 1))
      continue
    fi

    local actual
    actual=$(cmd_hash "$path")
    if [ "$actual" = "$expected" ]; then
      echo "OK:      $name"
      pass=$((pass + 1))
    else
      echo "MISMATCH: $name"
      echo "          expected: sha256:$expected"
      echo "          actual:   sha256:$actual"
      fail=$((fail + 1))
    fi
  done < "$lock_file"

  echo ""
  echo "vpstack-lock verify: $pass/$total OK"
  [ "$fail" -eq 0 ]
}

cmd_add() {
  local name="$1" path="$2" source="${3:-$2}"
  local lock_file="checkpoints.lock"
  [ -f "$path" ] || { echo "Error: $path not found" >&2; exit 1; }
  local hash
  hash=$(cmd_hash "$path")
  if [ ! -f "$lock_file" ]; then
    echo "# checkpoints.lock — generated by vpstack-lock" > "$lock_file"
  fi
  echo "$name  sha256:$hash  $source" >> "$lock_file"
  echo "Added: $name = sha256:${hash:0:16}..." >&2
}

SUBCMD="${1:-help}"
shift || true

case "$SUBCMD" in
  generate) cmd_generate "$@" ;;
  verify)   cmd_verify "$@" ;;
  add)      cmd_add "$@" ;;
  -h|--help|help)
    sed -n '2,/^$/p' "$0" | sed 's/^# \?//'; exit 0 ;;
  *) echo "Error: unknown subcommand: $SUBCMD" >&2; exit 1 ;;
esac
