#!/usr/bin/env bash
# vpstack-brain (vpbrain) — experiment store CLI for VP2026 research.
#
# Mirrors gstack's gbrain pattern: a lightweight CLI over the JSONL files
# vpstack already writes to ~/.vpstack/projects/{slug}/.
#
# Operations:
#   vpstack-brain list                            # all experiments newest-first
#   vpstack-brain top --metric eer [--limit 10]   # top N by metric (eer/wer/linkability)
#   vpstack-brain top --metric wer --order asc    # WER lower-is-better
#   vpstack-brain show <exp_id>                   # full details for one experiment
#   vpstack-brain diff <exp_a> <exp_b>            # side-by-side comparison
#   vpstack-brain query "search text"             # substring search across hypothesis/method/tags
#   vpstack-brain stats                           # summary: count, best EER, EER trend
#   vpstack-brain learnings [--query TEXT]        # show research learnings
#   vpstack-brain timeline [--last 10]            # recent skill activity
#   vpstack-brain projects                        # list all known project slugs
#
# Cross-project queries:
#   vpstack-brain --slug <project-slug> list      # query a different project without cd
#   vpstack-brain --project <slug> top --metric eer
#
# vpstack-brain reads JSONL files directly. No database. Same data the skills write.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Parse leading --slug / --project flag (must come before the subcommand)
SLUG_OVERRIDE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --slug|--project) SLUG_OVERRIDE="$2"; shift 2 ;;
    *) break ;;
  esac
done

if [ -n "$SLUG_OVERRIDE" ]; then
  SLUG="$SLUG_OVERRIDE"
else
  SLUG=$("${SCRIPT_DIR}/vpstack-slug" 2>/dev/null || basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")
fi
export SLUG
PROJECT_DIR="$HOME/.vpstack/projects/$SLUG"
EXP_DIR="$PROJECT_DIR/experiments"
LEARNINGS="$PROJECT_DIR/learnings.jsonl"
TIMELINE="$HOME/.vpstack/analytics/timeline.jsonl"

cmd_help() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
}

# ----- list -----
cmd_list() {
  if [ ! -d "$EXP_DIR" ]; then
    echo "No experiments yet for project $SLUG"
    return
  fi
  EXP_DIR="$EXP_DIR" python3 - << 'PYEOF'
import os, json
from pathlib import Path
exp_root = Path(os.environ["EXP_DIR"])
rows = []
for d in sorted(exp_root.iterdir(), reverse=True):
    if not d.is_dir(): continue
    f = d / "summary.json"
    if not f.exists(): continue
    try:
        s = json.load(open(f))
    except Exception:
        continue
    m = s.get("metrics") or {}
    rows.append({
        "id": s.get("id", d.name),
        "date": (s.get("date") or "")[:10],
        "method": s.get("method", "—"),
        "eer": m.get("eer"),
        "wer": m.get("wer"),
    })
if not rows:
    print("No experiments logged yet.")
else:
    print(f"{'EXP_ID':<40} {'DATE':<11} {'METHOD':<25} {'EER':>7} {'WER':>7}")
    print("-" * 95)
    for r in rows:
        eer = f"{r['eer']:.2f}" if isinstance(r['eer'], (int,float)) else "—"
        wer = f"{r['wer']:.2f}" if isinstance(r['wer'], (int,float)) else "—"
        print(f"{r['id'][:40]:<40} {r['date']:<11} {r['method'][:25]:<25} {eer:>7} {wer:>7}")
PYEOF
}

# ----- top -----
cmd_top() {
  local metric="eer" limit=10 order=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --metric) metric="$2"; shift 2 ;;
      --limit)  limit="$2";  shift 2 ;;
      --order)  order="$2";  shift 2 ;;
      *) shift ;;
    esac
  done
  EXP_DIR="$EXP_DIR" METRIC="$metric" LIMIT="$limit" ORDER="$order" \
  python3 - << 'PYEOF'
import os, json
from pathlib import Path
exp_root = Path(os.environ["EXP_DIR"])
metric = os.environ["METRIC"]
limit = int(os.environ["LIMIT"])
order = os.environ["ORDER"]

# Default direction per metric: EER higher=better, WER/linkability lower=better
default_desc = {"eer": True, "wer": False, "linkability": False}
desc = (order == "desc") if order in ("asc","desc") else default_desc.get(metric, True)
direction = "↑" if desc else "↓"

rows = []
for d in sorted(exp_root.iterdir(), reverse=True) if exp_root.exists() else []:
    if not d.is_dir(): continue
    f = d / "summary.json"
    if not f.exists(): continue
    try: s = json.load(open(f))
    except: continue
    v = (s.get("metrics") or {}).get(metric)
    if not isinstance(v, (int, float)): continue
    rows.append((float(v), s, d.name))

rows.sort(key=lambda x: x[0], reverse=desc)
rows = rows[:limit]

if not rows:
    print(f"No experiments with metric '{metric}'.")
else:
    print(f"Top {len(rows)} by {metric} ({direction} = better):")
    print(f"{'RANK':<5} {'VALUE':>8} {'EXP_ID':<40} {'METHOD':<25}")
    print("-" * 80)
    for i, (v, s, name) in enumerate(rows, 1):
        print(f"{i:<5} {v:>8.2f} {s.get('id', name)[:40]:<40} {s.get('method','—')[:25]:<25}")
PYEOF
}

# ----- show -----
cmd_show() {
  local exp_id="$1"
  local f="$EXP_DIR/$exp_id/summary.json"
  if [ ! -f "$f" ]; then
    echo "Error: experiment $exp_id not found at $f" >&2
    return 1
  fi
  python3 -c "import json,sys; print(json.dumps(json.load(open(sys.argv[1])), indent=2))" "$f"
}

# ----- diff -----
cmd_diff() {
  local exp_a="$1" exp_b="$2"
  EXP_DIR="$EXP_DIR" EXP_A="$exp_a" EXP_B="$exp_b" python3 - << 'PYEOF'
import os, json
from pathlib import Path
root = Path(os.environ["EXP_DIR"])
a = json.load(open(root / os.environ["EXP_A"] / "summary.json"))
b = json.load(open(root / os.environ["EXP_B"] / "summary.json"))

def fmt(v):
    if isinstance(v, (int, float)):
        return f"{v:.2f}"
    return str(v) if v is not None else "—"

print(f"{'FIELD':<22} {os.environ['EXP_A'][:30]:<30} {os.environ['EXP_B'][:30]:<30}  Δ")
print("-" * 100)
for field in ("date", "method", "config_hash", "hypothesis"):
    print(f"{field:<22} {str(a.get(field,''))[:30]:<30} {str(b.get(field,''))[:30]:<30}")

print()
print(f"{'METRIC':<22} {'A':<30} {'B':<30}  Δ")
print("-" * 100)
ma = a.get("metrics") or {}
mb = b.get("metrics") or {}
for k in sorted(set(ma) | set(mb)):
    va, vb = ma.get(k), mb.get(k)
    delta = ""
    if isinstance(va, (int, float)) and isinstance(vb, (int, float)):
        d = vb - va
        sign = "+" if d > 0 else ""
        delta = f"{sign}{d:.2f}"
    print(f"{k:<22} {fmt(va):<30} {fmt(vb):<30}  {delta}")
PYEOF
}

# ----- query -----
cmd_query() {
  local query="$1"
  EXP_DIR="$EXP_DIR" QUERY="$query" python3 - << 'PYEOF'
import os, json
from pathlib import Path
root = Path(os.environ["EXP_DIR"])
q = os.environ["QUERY"].lower()
matches = []
if root.exists():
    for d in sorted(root.iterdir(), reverse=True):
        if not d.is_dir(): continue
        f = d / "summary.json"
        if not f.exists(): continue
        try: s = json.load(open(f))
        except: continue
        searchable = " ".join(str(s.get(k, "")) for k in
            ("id", "method", "system_name", "hypothesis"))
        searchable += " " + " ".join(s.get("tags") or [])
        if q in searchable.lower():
            matches.append(s)
print(f"Found {len(matches)} experiments matching '{q}':")
print()
for s in matches:
    m = s.get("metrics") or {}
    eer = m.get("eer", "—")
    print(f"  {s.get('id','')}  EER={eer}  method={s.get('method','—')}")
    if s.get("hypothesis"):
        print(f"    hypothesis: {s['hypothesis'][:80]}")
PYEOF
}

# ----- stats -----
cmd_stats() {
  EXP_DIR="$EXP_DIR" python3 - << 'PYEOF'
import os, json
from pathlib import Path
root = Path(os.environ["EXP_DIR"])
total = 0
eers = []
wers = []
methods = {}
if root.exists():
    for d in sorted(root.iterdir()):
        if not d.is_dir(): continue
        f = d / "summary.json"
        if not f.exists(): continue
        try: s = json.load(open(f))
        except: continue
        total += 1
        m = s.get("metrics") or {}
        if isinstance(m.get("eer"), (int, float)): eers.append((s.get("date",""), float(m["eer"])))
        if isinstance(m.get("wer"), (int, float)): wers.append(float(m["wer"]))
        method = s.get("method", "—")
        methods[method] = methods.get(method, 0) + 1

print(f"Project: {os.environ.get('SLUG','?')}")
print(f"Total experiments: {total}")
if eers:
    eers.sort()
    best = max(eers, key=lambda x: x[1])
    print(f"Best EER: {best[1]:.2f} ({best[0][:10]})")
    if len(eers) >= 2:
        first, last = eers[0][1], eers[-1][1]
        delta = last - first
        sign = "+" if delta > 0 else ""
        direction = "improving" if delta > 0 else "declining" if delta < 0 else "flat"
        print(f"EER trend: {first:.2f} → {last:.2f} ({sign}{delta:.2f}pp, {direction})")
if wers:
    print(f"Best WER: {min(wers):.2f}")
print()
print("By method:")
for m, n in sorted(methods.items(), key=lambda x: -x[1]):
    print(f"  {m}: {n}")
PYEOF
}

# ----- learnings -----
# Read the per-project learnings.jsonl directly so --slug override propagates.
cmd_learnings() {
  local query="" limit=10
  while [ $# -gt 0 ]; do
    case "$1" in
      --query) query="$2"; shift 2 ;;
      --limit) limit="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  if [ ! -f "$LEARNINGS" ]; then
    echo "No learnings yet for project $SLUG"
    echo "Use vpstack-learnings-log to record research insights."
    return
  fi
  LEARNINGS="$LEARNINGS" QUERY="$query" LIMIT="$limit" python3 - << 'PYEOF'
import os, json, sys
entries = []
with open(os.environ["LEARNINGS"]) as f:
    for line in f:
        line = line.strip()
        if not line: continue
        try: entries.append(json.loads(line))
        except json.JSONDecodeError: continue
entries.reverse()  # newest first

q = os.environ["QUERY"].lower()
if q:
    entries = [e for e in entries
               if q in e.get("key","").lower()
               or q in e.get("insight","").lower()
               or q in " ".join(e.get("tags", [])).lower()]
entries = entries[:int(os.environ["LIMIT"])]

if not entries:
    print("No learnings match your query.")
    sys.exit(0)

print(f"Research learnings ({len(entries)} found):")
print()
for e in entries:
    conf = e.get("confidence", "?")
    src  = e.get("source", "manual")
    ts   = e.get("ts", "")[:10]
    key  = e.get("key", "")
    insight = e.get("insight", "")
    print(f"[{key}] (confidence: {conf}, source: {src}, {ts})")
    print(f"  {insight}")
    print()
PYEOF
}

# ----- timeline -----
# Filter to the active slug so timeline matches every other subcommand's scope.
cmd_timeline() {
  local last=10
  while [ $# -gt 0 ]; do
    case "$1" in
      --last) last="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  if [ ! -f "$TIMELINE" ]; then
    echo "No timeline data yet. Skill runs are logged to $TIMELINE."
    return
  fi
  TIMELINE="$TIMELINE" SLUG="$SLUG" LAST="$last" python3 - << 'PYEOF'
import os, json
slug = os.environ["SLUG"]
last = int(os.environ["LAST"])
matched = []
with open(os.environ["TIMELINE"]) as f:
    for line in f:
        try: d = json.loads(line)
        except json.JSONDecodeError: continue
        if d.get("slug") and d["slug"] != slug: continue
        matched.append(d)
matched = matched[-last:]
if not matched:
    print(f"No skill runs logged for project {slug} yet.")
else:
    print(f"Last {len(matched)} skill runs for {slug}:")
    for d in matched:
        skill = d.get("skill", "?")
        event = d.get("event", "?")
        ts = d.get("ts", "")[:19].replace("T", " ")
        branch = d.get("branch", "")
        print(f"  {ts}  {skill:<25} {event:<10} {branch}")
PYEOF
}

# ----- projects -----
# List every known project slug under ~/.vpstack/projects/, with experiment counts.
cmd_projects() {
  local root="$HOME/.vpstack/projects"
  if [ ! -d "$root" ]; then
    echo "No projects yet. Run a vpstack skill in a voice-anonymization repo to bootstrap."
    return
  fi
  ROOT="$root" CURRENT="$SLUG" python3 - << 'PYEOF'
import os
from pathlib import Path
root = Path(os.environ["ROOT"])
current = os.environ["CURRENT"]
rows = []
for p in sorted(root.iterdir()):
    if not p.is_dir(): continue
    exp_count = 0
    exp_dir = p / "experiments"
    if exp_dir.exists():
        exp_count = sum(1 for d in exp_dir.iterdir() if d.is_dir() and (d / "summary.json").exists())
    learn_count = 0
    learn_file = p / "learnings.jsonl"
    if learn_file.exists():
        with open(learn_file) as f:
            learn_count = sum(1 for line in f if line.strip())
    rows.append((p.name, exp_count, learn_count))
if not rows:
    print("No projects yet.")
else:
    print(f"{'PROJECT':<48} {'EXPS':>6} {'LEARN':>6}")
    print("-" * 64)
    for name, e, l in rows:
        marker = " ←" if name == current else ""
        print(f"{name[:48]:<48} {e:>6} {l:>6}{marker}")
PYEOF
}

# ----- dispatch -----
SUBCMD="${1:-help}"
shift || true

case "$SUBCMD" in
  list)       cmd_list "$@" ;;
  top)        cmd_top "$@" ;;
  show)       cmd_show "$@" ;;
  diff)       cmd_diff "$@" ;;
  query)      cmd_query "$@" ;;
  stats)      cmd_stats "$@" ;;
  learnings)  cmd_learnings "$@" ;;
  timeline)   cmd_timeline "$@" ;;
  projects)   cmd_projects "$@" ;;
  -h|--help|help) cmd_help ;;
  *) echo "Unknown subcommand: $SUBCMD. Run 'vpstack-brain help'." >&2; exit 1 ;;
esac
